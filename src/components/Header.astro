---
/*
 * Header — WARM CARD-FEED masthead ("Kitchen Table").
 *
 *   ┌────────────────────────────────────────────┐
 *   │   Kitchen Table                       ⌕     │   ← wordmark only
 *   └────────────────────────────────────────────┘
 *
 * No horizontal section nav here — this is a social-feed shell, not a
 * magazine. Navigation lives in the floating pill bar (FeedNav) at the
 * bottom of the viewport on every screen size. The masthead carries only
 * the brand wordmark (centered) and a single search affordance so the feed
 * reads like a gentle timeline, not a newsstand.
 */
import HeaderControls from '~/components/HeaderControls.tsx'
import StatusBanner from '~/components/StatusBanner.astro'
import Wordmark from '~/components/Wordmark.astro'
---

<StatusBanner />
<header class="feed-masthead" transition:persist="site-header">
  <div class="feed-masthead-inner">
    <div class="fm-brand">
      <Wordmark size={21} href="/" />
    </div>
    <div class="fm-controls">
      <HeaderControls client:idle />
    </div>
  </div>
</header>

<style>
  .feed-masthead {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in oklab, var(--paper) 88%, transparent);
    backdrop-filter: saturate(160%) blur(12px);
    -webkit-backdrop-filter: saturate(160%) blur(12px);
    border-bottom: 1px solid var(--rule);
  }
  .feed-masthead-inner {
    max-width: 640px;
    margin-inline: auto;
    height: 58px;
    padding-inline: clamp(1rem, 5vw, 1.5rem);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }
  /* Wordmark stays centered; controls float to the right edge. */
  .fm-brand {
    display: inline-flex;
    align-items: center;
  }
  .fm-controls {
    position: absolute;
    right: clamp(1rem, 5vw, 1.5rem);
    top: 50%;
    transform: translateY(-50%);
    display: inline-flex;
    align-items: center;
  }
</style>
