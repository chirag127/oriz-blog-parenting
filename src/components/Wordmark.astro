---
/*
 * Wordmark — "Kitchen Table" set in the display serif (Fraunces) with a short
 * mulberry pencil growth-mark tucked under the last word — the doorframe
 * height-tick rendered as the brand mark. Ties the masthead to the site's
 * signature (the growth ruler on the homepage).
 *
 * Each oriz site owns its own wordmark; this one is warm-serif + growth-tick,
 * not the newspaper z-strike used by oriz-blog.
 */

interface Props {
  /** Sub-section name — rendered after a `·` separator. */
  subtitle?: string
  /** Display size in CSS pixels. */
  size?: number
  /** Wrap the mark in an <a href>. */
  href?: string | null
  /** Render as <h1> (the masthead) rather than <div>. */
  asHeading?: boolean
}

const { subtitle, size = 24, href = null, asHeading = false } = Astro.props
const Tag = asHeading ? 'h1' : ('div' as const)
---

{
  href ? (
    <a class="wordmark-link" href={href} aria-label={subtitle ? `Kitchen Table · ${subtitle}` : 'Kitchen Table'}>
      <Tag class="wordmark" style={`--wm-size: ${size}px;`}>
        <span class="wm-name">
          <span class="wm-word">Kitchen</span>{' '}
          <span class="wm-word wm-word-mark">
            Table
            <span class="wm-tick" aria-hidden="true" />
          </span>
        </span>
        {subtitle && (
          <>
            <span class="wm-sep" aria-hidden="true">·</span>
            <span class="wm-sub">{subtitle}</span>
          </>
        )}
      </Tag>
    </a>
  ) : (
    <Tag class="wordmark" style={`--wm-size: ${size}px;`}>
      <span class="wm-name">
        <span class="wm-word">Kitchen</span>{' '}
        <span class="wm-word wm-word-mark">
          Table
          <span class="wm-tick" aria-hidden="true" />
        </span>
      </span>
      {subtitle && (
        <>
          <span class="wm-sep" aria-hidden="true">·</span>
          <span class="wm-sub">{subtitle}</span>
        </>
      )}
    </Tag>
  )
}

<style>
  .wordmark-link {
    display: inline-block;
    color: inherit;
    text-decoration: none;
  }
  .wordmark {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4em;
    margin: 0;
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-weight: 560;
    font-size: var(--wm-size, 24px);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .wm-name {
    display: inline-flex;
    align-items: baseline;
  }
  .wm-word-mark {
    position: relative;
  }
  /* the pencil growth-mark under "Table" */
  .wm-tick {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.12em;
    height: 0.11em;
    min-height: 2px;
    background: var(--accent);
    border-radius: 2px;
  }
  .wm-sep {
    color: var(--ink-mute);
    font-weight: 400;
    font-size: 0.85em;
  }
  .wm-sub {
    color: var(--accent);
    font-family: var(--font-utility);
    font-weight: 600;
    font-size: 0.62em;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    align-self: center;
  }
</style>
