---
/**
 * PostCard — "fridge note" card style unique to Kitchen Table / parenting blog.
 *
 * A soft rounded card with a left crayon stripe (vertical color), a hand-set
 * age-stage eyebrow, display title, and dek. NO newspaper-row shape — this is
 * a sticky note on a warm wall, not a broadsheet column. Used by every listing
 * (index, tag, category, related).
 */
import type { CollectionEntry } from 'astro:content'
import { formatPostDate, postVertical, slugifyTag, verticalLabel } from '~/lib/blog'

export interface Props {
  post: CollectionEntry<'blog'>
}

const { post } = Astro.props
const { title, description, pubDate, category, readingTime } = post.data
const href = `/blog/${post.id}`
const catHref = `/categories/${slugifyTag(category)}/`
const vert = postVertical(post)
---

<article class="post-card" data-vertical={vert}>
  <a class="post-card-link" href={href}>
    <span class="post-card-kicker">
      <span class="post-card-dot" aria-hidden="true"></span>
      <span class="post-card-desk">{verticalLabel(vert)}</span>
      <span class="post-card-cat">{category}</span>
    </span>
    <h3 class="post-card-title">{title}</h3>
    {description && <p class="post-card-desc">{description}</p>}
    <span class="post-card-foot">
      <time datetime={pubDate.toISOString()}>{formatPostDate(pubDate)}</time>
      {readingTime && <span class="post-card-rt">{readingTime}</span>}
    </span>
  </a>
  <a class="post-card-cat-link" href={catHref} aria-label={`More in ${category}`}>{category}</a>
</article>

<style>
  /* Soft "fridge note" card — rounded, shadowed, crayon stripe on left */
  .post-card {
    position: relative;
    background: var(--paper-2);
    border: 1px solid var(--rule);
    border-radius: var(--radius-card);
    box-shadow: 0 1px 0 var(--rule), 0 6px 20px -18px color-mix(in oklab, var(--ink) 35%, transparent);
    --v: var(--v-personal);
    overflow: hidden;
    /* crayon stripe — left edge in vertical colour */
    border-left: 4px solid var(--v);
  }
  .post-card[data-vertical='dev']     { --v: var(--v-dev); }
  .post-card[data-vertical='finance'] { --v: var(--v-finance); }
  .post-card[data-vertical='culture'] { --v: var(--v-culture); }
  .post-card[data-vertical='health']  { --v: var(--v-health); }

  .post-card-link {
    display: grid;
    gap: 0.45rem;
    padding: 1.1rem 1.1rem 1.1rem 1rem;
    text-decoration: none;
    color: var(--ink);
  }

  .post-card-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-utility);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }
  .post-card-dot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--v);
    flex: 0 0 auto;
  }
  .post-card-desk { color: var(--v); }
  .post-card-cat {
    color: var(--ink-mute);
    border-left: 1px solid var(--rule-strong);
    padding-left: 0.45rem;
  }

  .post-card-title {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-size: clamp(1.15rem, 3vw, 1.35rem);
    font-weight: 520;
    letter-spacing: -0.015em;
    line-height: 1.2;
    margin: 0;
    color: var(--ink);
    transition: color var(--dur-fast) ease;
  }
  .post-card-link:hover .post-card-title { color: var(--accent); }

  .post-card-desc {
    color: var(--ink-mute);
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: 1.5;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    line-clamp: 2;
    overflow: hidden;
  }

  .post-card-foot {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-utility);
    font-size: 11px;
    font-weight: 500;
    color: var(--ink-mute);
  }
  .post-card-rt::before {
    content: '·';
    margin-right: 0.5rem;
    color: var(--rule-strong);
  }

  /* lift on hover */
  .post-card {
    transition:
      transform var(--dur-fast) var(--ease-out),
      box-shadow var(--dur-fast) var(--ease-out);
  }
  .post-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 1px 0 var(--rule), 0 14px 32px -18px color-mix(in oklab, var(--ink) 50%, transparent);
  }

  /* Sibling deep-link to category — visually hidden, keyboard reachable. */
  .post-card-cat-link {
    position: absolute;
    inset: 0 0 auto auto;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .post-card-cat-link:focus-visible {
    width: auto;
    height: auto;
    clip: auto;
    top: 1rem;
    right: 0.75rem;
    padding: 0.125rem 0.5rem;
    background: var(--paper);
    border: 1px solid var(--accent);
    border-radius: 999px;
    color: var(--accent);
    font-family: var(--font-utility);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  @media (prefers-reduced-motion: reduce) {
    .post-card { transition: none; }
    .post-card:hover { transform: none; }
  }
</style>
