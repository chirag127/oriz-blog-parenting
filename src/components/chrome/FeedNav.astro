---
/*
 * FeedNav — floating pill navigation bar (the WARM CARD-FEED signature).
 *
 * A soft, rounded, glassy pill that floats above the feed at the bottom of
 * the viewport on EVERY screen size — the way a friendly social app keeps
 * its primary tabs within thumb reach. Replaces both the old horizontal
 * header nav and the flat mobile BottomBar.
 *
 *   desktop / mobile:      ( ⌂ Feed   ✎ Guides   # Corners   ⌕ Find )
 *                          └── centered, floating, rounded-full ──┘
 *
 * Active route gets a filled mulberry lozenge. Labels hide on very narrow
 * screens (icon-only) but stay for accessibility via aria-label.
 */
const path = Astro.url.pathname
const isActive = (href: string, exact = false) =>
  exact ? path === href : path === href || path.startsWith(href)

const items = [
  { label: 'Feed', href: '/', glyph: 'home', active: isActive('/', true) },
  { label: 'Guides', href: '/series/', glyph: 'guides', active: isActive('/series/') },
  { label: 'Corners', href: '/categories/', glyph: 'corners', active: isActive('/categories/') || isActive('/tags/') },
  { label: 'About', href: '/about/', glyph: 'about', active: isActive('/about/') },
  { label: 'Find', href: '/search/', glyph: 'find', active: isActive('/search/') },
]
---

<nav class="feed-nav" aria-label="Primary" transition:persist="feed-nav">
  <ul class="feed-nav-pill">
    {items.map((it) => (
      <li>
        <a
          href={it.href}
          class:list={['fn-tab', it.active && 'is-active']}
          aria-current={it.active ? 'page' : undefined}
          data-glyph={it.glyph}
        >
          <span class="fn-dot" aria-hidden="true"></span>
          <span class="fn-label">{it.label}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .feed-nav {
    position: fixed;
    left: 50%;
    bottom: max(1rem, env(safe-area-inset-bottom, 0px));
    transform: translateX(-50%);
    z-index: 60;
    width: max-content;
    max-width: calc(100vw - 1.5rem);
  }
  .feed-nav-pill {
    list-style: none;
    margin: 0;
    padding: 0.4rem;
    display: flex;
    align-items: center;
    gap: 0.15rem;
    background: color-mix(in oklab, var(--paper-2) 82%, transparent);
    border: 1px solid var(--rule);
    border-radius: 999px;
    box-shadow:
      0 10px 30px -12px color-mix(in oklab, var(--ink) 40%, transparent),
      0 2px 6px -3px color-mix(in oklab, var(--ink) 25%, transparent);
    backdrop-filter: saturate(160%) blur(14px);
    -webkit-backdrop-filter: saturate(160%) blur(14px);
  }
  .fn-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.5rem 0.95rem;
    border-radius: 999px;
    text-decoration: none;
    color: var(--ink-mute);
    font-family: var(--font-utility, var(--font-body));
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    line-height: 1;
    white-space: nowrap;
    transition:
      color var(--dur-fast, 140ms) var(--ease-out, ease),
      background var(--dur-fast, 140ms) var(--ease-out, ease);
  }
  /* a small crayon dot marks each tab — echoing the feed's vertical chips */
  .fn-dot {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: currentColor;
    opacity: 0.55;
    flex: 0 0 auto;
  }
  .fn-tab:hover {
    color: var(--ink);
    background: color-mix(in oklab, var(--accent) 8%, transparent);
  }
  .fn-tab:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .fn-tab.is-active {
    color: var(--color-accent-fg, #fff);
    background: var(--accent);
  }
  .fn-tab.is-active .fn-dot { opacity: 1; background: var(--color-accent-fg, #fff); }

  /* Narrow screens: icon-dot only, labels collapse to keep the pill within
     thumb reach. The active tab still shows its label so context is kept. */
  @media (max-width: 420px) {
    .fn-tab { padding: 0.55rem 0.7rem; }
    .fn-tab .fn-label { display: none; }
    .fn-tab.is-active .fn-label { display: inline; }
    .fn-tab.is-active { padding-inline: 0.85rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .fn-tab { transition: none; }
  }
</style>
