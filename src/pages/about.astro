---
import BaseLayout from '~/layouts/BaseLayout.astro'

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Chirag Singhal',
  url: 'https://oriz.in/about/',
  jobTitle: 'Software Engineer',
  description:
    'Software engineer specializing in scalable backend architectures, full-stack development, AI agents, and cloud-native deployments.',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Bhubaneswar',
    addressRegion: 'Odisha',
    addressCountry: 'IN',
  },
  sameAs: [
    'https://github.com/chirag127',
    'https://x.com/chirag127',
    'https://linkedin.com/in/chirag127',
  ],
}
---

<BaseLayout
  title="About — Kitchen Table"
  description="About Kitchen Table — calm, practical, judgement-free writing on raising kids and family life."
  jsonLd={jsonLd}
  hideSidebar={true}
>
  <header class="page-head">
    <p class="eyebrow"><a href="/">Kitchen Table</a> / About</p>
    <h1>About</h1>
  </header>

  <article class="prose">
    <p class="lede">
      Kitchen Table is calm, practical writing about raising kids — the part
      that happens between the milestones, on ordinary days, when nobody's
      watching.
    </p>

    <h2>What gets posted here</h2>
    <p>
      Tested notes on the things that actually fill a parent's week: screens and
      sleep, reading and play, routines, big feelings, and sharing the load
      between grown-ups. No shame, no perfect-parent performance — just what
      helps and what doesn't.
    </p>

    <h2>How to read it</h2>
    <p>
      Every post is meant to be useful on a tired evening: short enough to
      finish, specific enough to try tomorrow. Where the science is genuinely
      unsettled, it says so. Where a rule is really just what worked in one
      family, it says that too.
    </p>

    <h2>Who writes it</h2>
    <p>
      Written by <a href="https://oriz.in">Chirag Singhal</a>. Kitchen Table is
      part of the wider <a href="https://oriz.in">oriz</a> family of small,
      free, quiet sites — no newsletters you didn't ask for, no popups, no paid
      tier.
    </p>

    <h2>Contact</h2>
    <p>
      Email: <a href="mailto:whyiswhen@gmail.com">whyiswhen@gmail.com</a>.
      Or use the <a href="/contact/">contact form</a>.
    </p>
  </article>
</BaseLayout>

<style>
  .page-head { padding-block: 3rem 1.5rem; border-bottom: 1px solid var(--color-border); max-width: var(--container-prose, 720px); margin-inline: auto; }
  .eyebrow { color: var(--color-fg-muted); font-size: 0.8125rem; margin: 0 0 0.5rem; }
  .eyebrow a { color: var(--color-fg-muted); text-decoration: none; }
  .eyebrow a:hover { color: var(--color-fg); }
  h1 { font-family: var(--font-serif); font-size: clamp(2rem, 4vw, 2.75rem); font-weight: 600; letter-spacing: -0.02em; margin: 0; }
  .prose { padding-block: 2.5rem 4rem; color: var(--color-prose); line-height: 1.75; font-size: 1.0625rem; max-width: var(--container-prose, 720px); margin-inline: auto; }
  .prose .lede { font-size: 1.1875rem; color: var(--color-fg); margin: 0 0 2rem; }
  .prose h2 { font-family: var(--font-serif); font-size: 1.5rem; font-weight: 600; color: var(--color-fg); margin: 2.5rem 0 1rem; }
  .prose p { margin: 0 0 1.25rem; }
  .prose a { color: var(--color-accent); }
</style>
