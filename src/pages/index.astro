---
/**
 * /  — Parenting & Family homepage, WARM CARD-FEED (SOCIAL) archetype.
 *
 * A single-column, gently scrolling timeline — like a calm family group where
 * everything worth keeping floats up as a soft rounded card. The feed opens
 * with a thesis card (the signature doorframe growth-ruler tucked inside it),
 * then flows:
 *
 *   • a pinned "Start here" card (the lead)
 *   • "Still writing" — in-progress series, as compact progress cards
 *   • the running feed of recent posts, each a soft social card
 *   • "Corners of the house" — categories as crayon chips
 *   • an "all caught up" cap that closes the timeline
 *
 * Verticals (Everyday/Learning/Wellbeing/Home/Us) carry a crayon colour
 * (--v-*). Rounded surfaces, mulberry accent, no cover images.
 */
import BaseLayout from '~/layouts/BaseLayout.astro'
import SeriesSpine from '~/components/SeriesSpine.astro'
import {
  getCategoriesWithCounts,
  getPostsInSeries,
  getPublishedPosts,
  getSeriesWithCounts,
  postVertical,
  readingTimeFor,
  slugifyTag,
  verticalFor,
  verticalLabel,
} from '~/lib/blog'
import { SITE_CONFIG } from '~/lib/config'

const allPosts = await getPublishedPosts()
const lead = allPosts[0]
const recentPosts = allPosts.slice(1, 9)

const seriesAll = await getSeriesWithCounts()
type InProgress = {
  name: string
  slug: string
  total: number
  published: number
  current: number
  latest: Date
  parts: Awaited<ReturnType<typeof getPostsInSeries>>
}
const inProgress: InProgress[] = []
for (const { series, count } of seriesAll.slice(0, 3)) {
  const parts = await getPostsInSeries(series)
  const latest = parts.reduce(
    (max, p) => (p.data.pubDate > max ? p.data.pubDate : max),
    parts[0].data.pubDate,
  )
  const explicitMax = parts.reduce((mx, p) => {
    const v = typeof p.data.part === 'number' ? p.data.part : Number(p.data.part)
    return Number.isFinite(v) ? Math.max(mx, v) : mx
  }, 0)
  const total = Math.max(count, explicitMax, count + 1)
  inProgress.push({
    name: series,
    slug: slugifyTag(series),
    total,
    published: count,
    current: count,
    latest,
    parts,
  })
}
inProgress.sort((a, b) => b.latest.valueOf() - a.latest.valueOf())

const cats = await getCategoriesWithCounts()

const leadVertical = lead ? postVertical(lead) : 'personal'
const leadRt = lead ? (lead.data.readingTime ?? readingTimeFor(lead)) : ''

function ago(date: Date): string {
  const days = Math.floor((Date.now() - date.valueOf()) / 86_400_000)
  if (days < 1) return 'today'
  if (days === 1) return '1 day ago'
  if (days < 30) return `${days} days ago`
  const months = Math.floor(days / 30)
  if (months === 1) return '1 month ago'
  if (months < 12) return `${months} months ago`
  const years = Math.floor(days / 365)
  return years === 1 ? '1 year ago' : `${years} years ago`
}
function dateLabel(d: Date): string {
  return d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })
}

// The doorframe growth ruler: milestone ticks, each a real stage of a family.
const milestones = [
  { at: '0', label: 'Newborn nights' },
  { at: '1', label: 'First steps' },
  { at: '3', label: 'Big feelings' },
  { at: '6', label: 'Reading alone' },
  { at: '10', label: 'Own opinions' },
]

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: SITE_CONFIG.title,
  url: `${SITE_CONFIG.url}/`,
  description: SITE_CONFIG.description,
  author: { '@type': 'Person', name: SITE_CONFIG.author.name, url: SITE_CONFIG.author.url },
}
---

<BaseLayout
  title="Kitchen Table — calm, practical family writing"
  description={SITE_CONFIG.description}
  jsonLd={jsonLd}
  hideSidebar
>
  <div class="feed">
    {/* ── Thesis card: the hero, with the doorframe ruler tucked inside ─── */}
    <section class="card card-hero" aria-label="Introduction">
      <p class="hero-eyebrow">Kitchen Table · a family notebook</p>
      <h1 class="hero-thesis">
        A family isn't built in a grand plan. It's built one small week at a time.
      </h1>
      <p class="hero-lede">
        Calm, tested notes on raising kids — screens, sleep, reading, routines, and the
        ordinary days in between. No shame, no perfect parents. Just what actually helps.
      </p>

      {/* Signature element — the doorframe growth chart, now inline in the card. */}
      <div class="growth-rail" aria-label="How families grow, marked like a doorframe">
        <span class="growth-caption">Marks on the doorframe</span>
        <ol class="growth-ticks">
          {milestones.map((m) => (
            <li class="growth-tick">
              <span class="growth-tick-line" aria-hidden="true"></span>
              <span class="growth-tick-age">{m.at} yr</span>
              <span class="growth-tick-label">{m.label}</span>
            </li>
          ))}
        </ol>
      </div>

      <div class="hero-actions">
        <a class="btn btn-primary" href="/blog/">Read the latest</a>
        <a class="btn btn-ghost" href="/about/">What this is</a>
      </div>
    </section>

    {lead && (
      <article class="card card-lead" data-vertical={leadVertical} aria-labelledby="lead-title">
        <a class="feed-link" href={`/blog/${lead.id}`}>
          <span class="feed-kicker">
            <span class="chip-dot" aria-hidden="true"></span>
            <span class="feed-desk">{verticalLabel(leadVertical)}</span>
            <span class="feed-flag">Start here</span>
          </span>
          <h2 id="lead-title" class="lead-title">{lead.data.title}</h2>
          <p class="lead-dek">{lead.data.description}</p>
          <span class="feed-meta">
            <time datetime={lead.data.pubDate.toISOString()}>{dateLabel(lead.data.pubDate)}</time>
            <span aria-hidden="true">·</span>
            <span>{leadRt}</span>
          </span>
        </a>
      </article>
    )}

    {/* ── Still writing — in-progress series as compact progress cards ──── */}
    {inProgress.length > 0 && (
      <section aria-labelledby="s-progress">
        <h2 id="s-progress" class="feed-divider">Still writing</h2>
        <ul class="stack">
          {inProgress.map((s) => (
            <li>
              <a class="card card-series" href={`/series/${s.slug}/`}>
                <span class="series-top">
                  <span class="series-name">{s.name}</span>
                  <span class="series-ago">{ago(s.latest)}</span>
                </span>
                <span class="series-spine-mount">
                  <SeriesSpine total={s.total} published={s.published} current={s.current} size="md" />
                </span>
                <span class="series-meta">part {s.published} of {s.total}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {/* ── The running feed of recent posts ──────────────────────────────── */}
    <section aria-labelledby="s-recent">
      <h2 id="s-recent" class="feed-divider">Fresh from the wall</h2>
      <ul class="stack">
        {recentPosts.map((p) => (
          <li>
            <article class="card card-post" data-vertical={postVertical(p)}>
              <a class="feed-link" href={`/blog/${p.id}`}>
                <span class="feed-kicker">
                  <span class="chip-dot" aria-hidden="true"></span>{verticalLabel(postVertical(p))}
                </span>
                <span class="post-title">{p.data.title}</span>
                <span class="post-dek">{p.data.description}</span>
                <span class="feed-meta">
                  <time datetime={p.data.pubDate.toISOString()}>{dateLabel(p.data.pubDate)}</time>
                  <span aria-hidden="true">·</span>
                  <span>{p.data.readingTime ?? readingTimeFor(p)}</span>
                </span>
              </a>
            </article>
          </li>
        ))}
      </ul>
      <p class="all-link">
        <a href="/archive/">Everything in the archive →</a>
      </p>
    </section>

    {/* ── Corners of the house — categories as crayon chips ─────────────── */}
    {cats.length > 0 && (
      <section aria-labelledby="s-cats">
        <h2 id="s-cats" class="feed-divider">Corners of the house</h2>
        <ul class="cats-grid">
          {cats.map((c) => (
            <li>
              <a href={`/categories/${slugifyTag(c.category)}/`} class="cats-chip" data-vertical={verticalFor(c.category)}>
                <span class="chip-dot" aria-hidden="true"></span>
                <span class="cats-name">{c.category}</span>
                <span class="cats-count">{c.count}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {/* ── Feed cap — closes the timeline the way a social feed does ─────── */}
    <p class="feed-cap" role="note">
      <span class="feed-cap-mark" aria-hidden="true">·</span>
      You're all caught up. Come back for the next small week.
    </p>
  </div>
</BaseLayout>

<style>
  /* ── Feed column ─────────────────────────────────────────────────────── */
  .feed {
    padding-inline: clamp(0.9rem, 4vw, 1.25rem);
    padding-block: clamp(1.25rem, 4vw, 2rem) 1rem;
    display: flex;
    flex-direction: column;
    gap: clamp(1rem, 3vw, 1.4rem);
  }
  .stack { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: clamp(0.75rem, 2.5vw, 1rem); }

  /* Section labels read as timeline dividers, not magazine section heads. */
  .feed-divider {
    font-family: var(--font-utility, var(--font-body));
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-mute);
    margin: 0.5rem 0 0.15rem;
    padding-left: 0.15rem;
  }

  /* Shared crayon chip-dot used across kickers + category chips. */
  .chip-dot {
    width: 9px;
    height: 9px;
    border-radius: 999px;
    background: var(--v, var(--accent));
    flex: 0 0 auto;
  }

  /* ── The soft card — the whole feed is made of these ─────────────────── */
  .card {
    background: var(--paper-2);
    border: 1px solid var(--rule);
    border-radius: var(--radius-card);
    box-shadow: 0 1px 0 var(--rule), 0 8px 24px -20px color-mix(in oklab, var(--ink) 40%, transparent);
  }
  .feed-link { display: grid; gap: 0.55rem; color: var(--ink); text-decoration: none; }

  .feed-kicker {
    display: inline-flex; align-items: center; gap: 0.5rem;
    font-family: var(--font-utility);
    font-size: 11px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--v, var(--ink-mute));
  }
  .feed-desk { color: var(--v, var(--accent)); }
  .feed-flag { color: var(--accent); padding-left: 0.55rem; border-left: 1px solid var(--rule-strong); }
  .feed-meta {
    display: inline-flex; gap: 0.5rem; align-items: center; margin-top: 0.1rem;
    font-family: var(--font-utility);
    font-size: 12px; font-weight: 500; color: var(--ink-mute);
  }

  /* ── Hero card ───────────────────────────────────────────────────────── */
  .card-hero { padding: clamp(1.5rem, 5vw, 2.25rem); }
  .hero-eyebrow {
    font-family: var(--font-utility);
    font-size: 12px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 1rem;
  }
  .hero-thesis {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-weight: 540;
    font-size: clamp(1.9rem, 6.5vw, 2.7rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin: 0;
    text-wrap: balance;
  }
  .hero-lede {
    font-family: var(--font-body);
    font-size: clamp(1rem, 2.2vw, 1.125rem);
    line-height: 1.55;
    color: var(--ink-mute);
    margin: 1.1rem 0 0;
  }

  /* ── Signature: doorframe growth ruler (now horizontal ticks in-card) ── */
  .growth-rail {
    position: relative;
    margin-top: 1.5rem;
    padding: 1.25rem 1.1rem 1.25rem 1.6rem;
    background: color-mix(in oklab, var(--accent) 4%, var(--paper));
    border: 1px solid var(--rule);
    border-radius: calc(var(--radius-card) - 6px);
  }
  .growth-rail::before {
    content: '';
    position: absolute;
    left: 0.85rem;
    top: 2.1rem;
    bottom: 1.25rem;
    width: 2px;
    background: color-mix(in oklab, var(--accent) 45%, var(--rule));
    border-radius: 2px;
  }
  .growth-caption {
    display: block;
    font-family: var(--font-utility);
    font-size: 11px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--ink-mute);
    margin-bottom: 1rem;
    padding-left: 0.35rem;
  }
  .growth-ticks {
    list-style: none; margin: 0; padding: 0;
    display: flex; flex-direction: column; gap: 0.8rem;
  }
  .growth-tick {
    position: relative;
    display: grid;
    grid-template-columns: 2.7rem 1fr;
    align-items: baseline;
    gap: 0.65rem;
    padding-left: 0.35rem;
  }
  .growth-tick-line {
    position: absolute;
    left: 0.5rem; top: 0.55em;
    width: 0.9rem; height: 2px;
    background: var(--accent);
    border-radius: 2px;
  }
  .growth-tick-age {
    font-family: var(--font-mono);
    font-size: 12px; font-weight: 600; color: var(--accent);
    text-align: right; font-variant-numeric: tabular-nums;
  }
  .growth-tick-label {
    font-family: var(--font-display);
    font-size: 0.95rem; font-weight: 460; color: var(--ink); line-height: 1.25;
  }

  .hero-actions { display: flex; flex-wrap: wrap; gap: 0.7rem; margin-top: 1.5rem; }
  .btn {
    display: inline-flex; align-items: center;
    font-family: var(--font-body); font-weight: 600; font-size: 0.95rem;
    padding: 0.65rem 1.3rem;
    border-radius: var(--radius-button);
    text-decoration: none;
    transition: background var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out);
  }
  .btn-primary { background: var(--accent); color: var(--color-accent-fg); border: 1px solid var(--accent); }
  .btn-primary:hover { background: color-mix(in oklab, var(--accent) 86%, black); }
  .btn-ghost { background: transparent; color: var(--ink); border: 1px solid var(--rule-strong); }
  .btn-ghost:hover { border-color: var(--accent); color: var(--accent); }

  /* ── Lead / "Start here" card ────────────────────────────────────────── */
  .card-lead {
    --v: var(--v-personal);
    padding: clamp(1.35rem, 4vw, 1.85rem);
    border-left: 4px solid var(--v);
  }
  .card-lead[data-vertical='dev'] { --v: var(--v-dev); }
  .card-lead[data-vertical='finance'] { --v: var(--v-finance); }
  .card-lead[data-vertical='culture'] { --v: var(--v-culture); }
  .card-lead[data-vertical='health'] { --v: var(--v-health); }
  .lead-title {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-size: clamp(1.5rem, 5vw, 2rem);
    font-weight: 540; letter-spacing: -0.018em; line-height: 1.14;
    margin: 0;
  }
  .card-lead .feed-link:hover .lead-title { color: var(--accent); }
  .lead-dek {
    font-family: var(--font-body);
    font-size: 1.05rem; line-height: 1.55; color: var(--ink-mute); margin: 0;
  }

  /* ── Series (in-progress) cards ──────────────────────────────────────── */
  .card-series {
    display: grid;
    gap: 0.55rem;
    padding: 1rem 1.15rem;
    color: var(--ink);
    text-decoration: none;
    transition: border-color var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out);
  }
  .card-series:hover { border-color: var(--accent); transform: translateY(-2px); }
  .card-series:hover .series-name { color: var(--accent); }
  .series-top { display: flex; align-items: baseline; justify-content: space-between; gap: 0.75rem; }
  .series-name {
    font-family: var(--font-display);
    font-size: 1.1rem; font-weight: 520; letter-spacing: -0.01em;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .series-ago, .series-meta {
    font-family: var(--font-utility);
    font-size: 12px; font-weight: 500; color: var(--ink-mute);
    flex: 0 0 auto;
  }
  .series-spine-mount { display: inline-flex; }

  /* ── Post cards (the running feed) ───────────────────────────────────── */
  .card-post {
    --v: var(--v-personal);
    padding: clamp(1.15rem, 3.5vw, 1.4rem);
    border-left: 4px solid var(--v);
    transition: border-color var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out);
  }
  .card-post[data-vertical='dev'] { --v: var(--v-dev); }
  .card-post[data-vertical='finance'] { --v: var(--v-finance); }
  .card-post[data-vertical='culture'] { --v: var(--v-culture); }
  .card-post[data-vertical='health'] { --v: var(--v-health); }
  .card-post:hover { transform: translateY(-2px); box-shadow: 0 1px 0 var(--rule), 0 14px 30px -20px color-mix(in oklab, var(--ink) 55%, transparent); }
  .card-post:hover .post-title { color: var(--accent); }
  .post-title {
    font-family: var(--font-display);
    font-size: 1.25rem; font-weight: 520; letter-spacing: -0.012em;
    color: var(--ink); line-height: 1.2;
  }
  .post-dek {
    font-family: var(--font-body);
    font-size: 0.975rem; color: var(--ink-mute); line-height: 1.5;
    display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; line-clamp: 2; overflow: hidden;
  }

  .all-link { margin: 1.1rem 0 0; font-family: var(--font-body); font-size: 0.95rem; font-weight: 600; padding-left: 0.15rem; }
  .all-link a { color: var(--accent); text-decoration: none; }
  .all-link a:hover { text-decoration: underline; text-underline-offset: 3px; }

  /* ── Categories ──────────────────────────────────────────────────────── */
  .cats-grid { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .cats-chip {
    --v: var(--v-personal);
    display: inline-flex; align-items: center; gap: 0.5rem;
    padding: 0.5rem 0.95rem;
    background: var(--paper-2);
    border: 1px solid var(--rule);
    border-radius: var(--radius-button);
    color: var(--ink); text-decoration: none;
    transition: border-color var(--dur-fast) var(--ease-out), background var(--dur-fast) var(--ease-out);
  }
  .cats-chip[data-vertical='dev'] { --v: var(--v-dev); }
  .cats-chip[data-vertical='finance'] { --v: var(--v-finance); }
  .cats-chip[data-vertical='culture'] { --v: var(--v-culture); }
  .cats-chip[data-vertical='health'] { --v: var(--v-health); }
  .cats-chip:hover { border-color: var(--v); background: color-mix(in oklab, var(--v) 8%, var(--paper-2)); }
  .cats-name { font-family: var(--font-body); font-size: 0.95rem; font-weight: 550; }
  .cats-count { font-family: var(--font-mono); font-size: 11px; color: var(--ink-mute); font-variant-numeric: tabular-nums; }

  /* ── Feed cap ────────────────────────────────────────────────────────── */
  .feed-cap {
    margin: 0.75rem 0 0;
    text-align: center;
    font-family: var(--font-body);
    font-size: 0.925rem;
    color: var(--ink-mute);
  }
  .feed-cap-mark { display: block; color: var(--accent); font-size: 1.4rem; line-height: 0.6; margin-bottom: 0.4rem; }
</style>
