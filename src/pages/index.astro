---
/**
 * /  — Parenting & Family homepage ("The Kitchen Wall").
 *
 * Hero is a thesis, not a big number: a warm sentence about how family life is
 * built one small week at a time, pinned beside the signature element — the
 * doorframe growth-chart ruler (vertical tick rail with milestone labels).
 *
 * Below, three warm strata:
 *   1. Ongoing        — series, framed as "chapters still being written"
 *   2. Fresh from the wall — recent posts, each with a crayon vertical chip
 *   3. Corners of the house — categories as crayon-tinted links
 *
 * Verticals (Everyday/Learning/Wellbeing/Home/Us) each carry a crayon colour
 * (--v-*). Rounded surfaces, mulberry accent, no cover images.
 */
import BaseLayout from '~/layouts/BaseLayout.astro'
import SeriesSpine from '~/components/SeriesSpine.astro'
import {
  getCategoriesWithCounts,
  getPostsInSeries,
  getPublishedPosts,
  getSeriesWithCounts,
  postVertical,
  readingTimeFor,
  slugifyTag,
  verticalFor,
  verticalLabel,
} from '~/lib/blog'
import { SITE_CONFIG } from '~/lib/config'

const allPosts = await getPublishedPosts()
const lead = allPosts[0]
const recentPosts = allPosts.slice(1, 8)

const seriesAll = await getSeriesWithCounts()
type InProgress = {
  name: string
  slug: string
  total: number
  published: number
  current: number
  latest: Date
  parts: Awaited<ReturnType<typeof getPostsInSeries>>
}
const inProgress: InProgress[] = []
for (const { series, count } of seriesAll.slice(0, 4)) {
  const parts = await getPostsInSeries(series)
  const latest = parts.reduce(
    (max, p) => (p.data.pubDate > max ? p.data.pubDate : max),
    parts[0].data.pubDate,
  )
  const explicitMax = parts.reduce((mx, p) => {
    const v = typeof p.data.part === 'number' ? p.data.part : Number(p.data.part)
    return Number.isFinite(v) ? Math.max(mx, v) : mx
  }, 0)
  const total = Math.max(count, explicitMax, count + 1)
  inProgress.push({
    name: series,
    slug: slugifyTag(series),
    total,
    published: count,
    current: count,
    latest,
    parts,
  })
}
inProgress.sort((a, b) => b.latest.valueOf() - a.latest.valueOf())

const cats = await getCategoriesWithCounts()

const leadVertical = lead ? postVertical(lead) : 'personal'
const leadRt = lead ? (lead.data.readingTime ?? readingTimeFor(lead)) : ''

function ago(date: Date): string {
  const days = Math.floor((Date.now() - date.valueOf()) / 86_400_000)
  if (days < 1) return 'today'
  if (days === 1) return '1 day ago'
  if (days < 30) return `${days} days ago`
  const months = Math.floor(days / 30)
  if (months === 1) return '1 month ago'
  if (months < 12) return `${months} months ago`
  const years = Math.floor(days / 365)
  return years === 1 ? '1 year ago' : `${years} years ago`
}

// The doorframe growth ruler: milestone ticks, each a real stage of a family.
const milestones = [
  { at: '0', label: 'Newborn nights' },
  { at: '1', label: 'First steps' },
  { at: '3', label: 'Big feelings' },
  { at: '6', label: 'Reading alone' },
  { at: '10', label: 'Own opinions' },
]

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: SITE_CONFIG.title,
  url: `${SITE_CONFIG.url}/`,
  description: SITE_CONFIG.description,
  author: { '@type': 'Person', name: SITE_CONFIG.author.name, url: SITE_CONFIG.author.url },
}
---

<BaseLayout
  title="Kitchen Table — calm, practical family writing"
  description={SITE_CONFIG.description}
  jsonLd={jsonLd}
  hideSidebar
>
  <div class="container-page">
    {/* ── Hero: thesis beside the doorframe growth ruler ─────────────── */}
    <section class="hero" aria-label="Introduction">
      <div class="hero-copy">
        <p class="hero-eyebrow">Kitchen Table · a family notebook</p>
        <h1 class="hero-thesis">
          A family isn't built in a grand plan. It's built one small week at a time.
        </h1>
        <p class="hero-lede">
          Calm, tested notes on raising kids — screens, sleep, reading, routines, and the
          ordinary days in between. No shame, no perfect parents. Just what actually helps.
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/blog/">Read the latest</a>
          <a class="btn btn-ghost" href="/about/">What this is</a>
        </div>
      </div>

      {/* Signature element — the doorframe growth chart. */}
      <aside class="growth-rail" aria-label="How families grow, marked like a doorframe">
        <span class="growth-caption">Marks on the doorframe</span>
        <ol class="growth-ticks">
          {milestones.map((m) => (
            <li class="growth-tick">
              <span class="growth-tick-line" aria-hidden="true"></span>
              <span class="growth-tick-age">{m.at} yr</span>
              <span class="growth-tick-label">{m.label}</span>
            </li>
          ))}
        </ol>
      </aside>
    </section>

    {lead && (
      <section class="lead" data-vertical={leadVertical} aria-labelledby="lead-title">
        <a class="lead-link" href={`/blog/${lead.id}`}>
          <span class="lead-kicker">
            <span class="chip-dot" aria-hidden="true"></span>
            <span class="lead-desk">{verticalLabel(leadVertical)}</span>
            <span class="lead-flag">Start here</span>
          </span>
          <h2 id="lead-title" class="lead-title">{lead.data.title}</h2>
          <p class="lead-dek">{lead.data.description}</p>
          <span class="lead-meta">
            <time datetime={lead.data.pubDate.toISOString()}>{lead.data.pubDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}</time>
            <span aria-hidden="true">·</span>
            <span>{leadRt}</span>
          </span>
        </a>
      </section>
    )}

    {/* ── Stratum 1 — ONGOING ───────────────────────────────────────── */}
    {inProgress.length > 0 && (
      <section class="stratum" aria-labelledby="s-progress">
        <h2 id="s-progress" class="stratum-h">Chapters still being written</h2>
        <ul class="progress-list">
          {inProgress.map((s) => (
            <li class="progress-row">
              <a class="progress-link" href={`/series/${s.slug}/`}>
                <span class="progress-name">{s.name}</span>
                <span class="progress-spine-mount">
                  <SeriesSpine total={s.total} published={s.published} current={s.current} size="md" />
                </span>
                <span class="progress-meta">part {s.published} of {s.total}</span>
                <span class="progress-ago">{ago(s.latest)}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {/* ── Stratum 2 — RECENT ────────────────────────────────────────── */}
    <section class="stratum" aria-labelledby="s-recent">
      <h2 id="s-recent" class="stratum-h">Fresh from the wall</h2>
      <ul class="recent-list">
        {recentPosts.map((p) => (
          <li class="recent-row" data-vertical={postVertical(p)}>
            <a class="recent-link" href={`/blog/${p.id}`}>
              <span class="recent-meat">
                <span class="recent-kicker">
                  <span class="chip-dot" aria-hidden="true"></span>{verticalLabel(postVertical(p))}
                </span>
                <span class="recent-title">{p.data.title}</span>
                <span class="recent-dek">{p.data.description}</span>
                <span class="recent-meta">
                  <time datetime={p.data.pubDate.toISOString()}>{p.data.pubDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}</time>
                  <span aria-hidden="true">·</span>
                  <span>{p.data.readingTime ?? readingTimeFor(p)}</span>
                </span>
              </span>
            </a>
          </li>
        ))}
      </ul>
      <p class="all-link">
        <a href="/archive/">Everything in the archive →</a>
      </p>
    </section>

    {/* ── Stratum 3 — CATEGORIES ────────────────────────────────────── */}
    {cats.length > 0 && (
      <section class="stratum" aria-labelledby="s-cats">
        <h2 id="s-cats" class="stratum-h">Corners of the house</h2>
        <ul class="cats-grid">
          {cats.map((c) => (
            <li>
              <a href={`/categories/${slugifyTag(c.category)}/`} class="cats-chip" data-vertical={verticalFor(c.category)}>
                <span class="chip-dot" aria-hidden="true"></span>
                <span class="cats-name">{c.category}</span>
                <span class="cats-count">{c.count}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
</BaseLayout>

<style>
  .container-page {
    max-width: 1040px;
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 4vw, 2rem);
  }

  /* Shared crayon chip-dot used across kickers + category chips. */
  .chip-dot {
    width: 9px;
    height: 9px;
    border-radius: 999px;
    background: var(--v, var(--accent));
    flex: 0 0 auto;
  }

  /* ── Hero ──────────────────────────────────────────────────────────── */

  .hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 5vw, 3.5rem);
    padding-block: clamp(2.5rem, 7vw, 4.5rem) clamp(1.5rem, 4vw, 2.5rem);
    align-items: center;
  }
  @media (min-width: 900px) {
    .hero {
      grid-template-columns: minmax(0, 1fr) 260px;
    }
  }
  .hero-eyebrow {
    font-family: var(--font-utility);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 1.25rem;
  }
  .hero-thesis {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-weight: 540;
    font-size: clamp(2.15rem, 5.4vw, 3.5rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin: 0;
    max-width: 18ch;
    text-wrap: balance;
  }
  .hero-lede {
    font-family: var(--font-body);
    font-size: clamp(1.0625rem, 1.8vw, 1.25rem);
    line-height: 1.55;
    color: var(--ink-mute);
    margin: 1.5rem 0 0;
    max-width: 46ch;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.95rem;
    padding: 0.7rem 1.35rem;
    border-radius: var(--radius-button);
    text-decoration: none;
    transition:
      background var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }
  .btn-primary {
    background: var(--accent);
    color: var(--color-accent-fg);
    border: 1px solid var(--accent);
  }
  .btn-primary:hover {
    background: color-mix(in oklab, var(--accent) 86%, black);
  }
  .btn-ghost {
    background: transparent;
    color: var(--ink);
    border: 1px solid var(--rule-strong);
  }
  .btn-ghost:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  /* ── Signature: doorframe growth ruler ─────────────────────────────── */

  .growth-rail {
    position: relative;
    padding: 1.5rem 1.25rem 1.5rem 1.75rem;
    background: var(--paper-2);
    border: 1px solid var(--rule);
    border-radius: var(--radius-card);
    box-shadow: 0 1px 0 var(--rule);
  }
  /* the doorframe edge — a soft wooden rail down the left */
  .growth-rail::before {
    content: '';
    position: absolute;
    left: 0.85rem;
    top: 2.4rem;
    bottom: 1.5rem;
    width: 2px;
    background: color-mix(in oklab, var(--accent) 45%, var(--rule));
    border-radius: 2px;
  }
  .growth-caption {
    display: block;
    font-family: var(--font-utility);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-mute);
    margin-bottom: 1.1rem;
    padding-left: 0.35rem;
  }
  .growth-ticks {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }
  .growth-tick {
    position: relative;
    display: grid;
    grid-template-columns: 2.7rem 1fr;
    align-items: baseline;
    gap: 0.65rem;
    padding-left: 0.35rem;
  }
  /* pencil height-mark reaching from the rail */
  .growth-tick-line {
    position: absolute;
    left: 0.5rem;
    top: 0.55em;
    width: 0.9rem;
    height: 2px;
    background: var(--accent);
    border-radius: 2px;
  }
  .growth-tick-age {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    color: var(--accent);
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .growth-tick-label {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 460;
    color: var(--ink);
    line-height: 1.25;
  }

  /* ── Lead / "Start here" ───────────────────────────────────────────── */

  .lead {
    --v: var(--v-personal);
    margin-top: 0.5rem;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    background: var(--paper-2);
    border: 1px solid var(--rule);
    border-radius: var(--radius-card);
    border-left: 4px solid var(--v);
  }
  .lead[data-vertical='dev'] { --v: var(--v-dev); }
  .lead[data-vertical='finance'] { --v: var(--v-finance); }
  .lead[data-vertical='culture'] { --v: var(--v-culture); }
  .lead[data-vertical='health'] { --v: var(--v-health); }
  .lead-link { display: grid; gap: 0.65rem; color: var(--ink); text-decoration: none; }
  .lead-kicker {
    display: inline-flex; align-items: center; gap: 0.55rem;
    font-family: var(--font-utility);
    font-size: 12px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--ink-mute);
  }
  .lead-desk { color: var(--v); }
  .lead-flag { color: var(--accent); padding-left: 0.55rem; border-left: 1px solid var(--rule-strong); }
  .lead-title {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-size: clamp(1.65rem, 3.6vw, 2.35rem);
    font-weight: 540;
    letter-spacing: -0.018em;
    line-height: 1.12;
    margin: 0;
    max-width: 22ch;
  }
  .lead-link:hover .lead-title { color: var(--accent); }
  .lead-dek {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--ink-mute);
    margin: 0;
    max-width: 58ch;
  }
  .lead-meta {
    display: inline-flex; gap: 0.5rem; align-items: center;
    font-family: var(--font-utility);
    font-size: 12px; font-weight: 500; color: var(--ink-mute);
  }

  /* ── Strata ────────────────────────────────────────────────────────── */

  .stratum { padding-block: clamp(2rem, 5vw, 3rem) 0.5rem; }
  .stratum-h {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-size: clamp(1.35rem, 2.6vw, 1.75rem);
    font-weight: 520;
    letter-spacing: -0.01em;
    color: var(--ink);
    margin: 0 0 1.35rem;
  }

  /* ── Ongoing ───────────────────────────────────────────────────────── */

  .progress-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.6rem; }
  .progress-link {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto auto;
    gap: 1rem;
    align-items: center;
    color: var(--ink);
    text-decoration: none;
    padding: 0.85rem 1.1rem;
    background: var(--paper-2);
    border: 1px solid var(--rule);
    border-radius: var(--radius-card);
    transition: border-color var(--dur-fast) var(--ease-out);
  }
  .progress-link:hover { border-color: var(--accent); }
  .progress-link:hover .progress-name { color: var(--accent); }
  .progress-name {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .progress-meta, .progress-ago {
    font-family: var(--font-utility);
    font-size: 12px; font-weight: 500; color: var(--ink-mute);
  }
  .progress-spine-mount { display: inline-flex; }

  @media (max-width: 640px) {
    .progress-link {
      grid-template-columns: 1fr auto;
      grid-template-areas: 'name ago' 'spine meta';
      row-gap: 0.4rem;
    }
    .progress-name { grid-area: name; }
    .progress-spine-mount { grid-area: spine; }
    .progress-meta { grid-area: meta; text-align: right; }
    .progress-ago { grid-area: ago; text-align: right; }
  }

  /* ── Recent ────────────────────────────────────────────────────────── */

  .recent-list {
    list-style: none; padding: 0; margin: 0;
    display: grid;
    gap: 0.85rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 720px) {
    .recent-list { grid-template-columns: 1fr 1fr; }
  }
  .recent-row {
    --v: var(--v-personal);
  }
  .recent-row[data-vertical='dev'] { --v: var(--v-dev); }
  .recent-row[data-vertical='finance'] { --v: var(--v-finance); }
  .recent-row[data-vertical='culture'] { --v: var(--v-culture); }
  .recent-row[data-vertical='health'] { --v: var(--v-health); }
  .recent-link {
    display: block;
    height: 100%;
    color: var(--ink);
    text-decoration: none;
    padding: 1.1rem 1.25rem;
    background: var(--paper-2);
    border: 1px solid var(--rule);
    border-radius: var(--radius-card);
    border-top: 3px solid var(--v);
    transition: border-color var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out);
  }
  .recent-link:hover { border-color: var(--accent); border-top-color: var(--v); transform: translateY(-2px); }
  .recent-link:hover .recent-title { color: var(--accent); }
  .recent-meat { display: flex; flex-direction: column; gap: 0.4rem; min-width: 0; }
  .recent-kicker {
    display: inline-flex; align-items: center; gap: 0.45rem;
    font-family: var(--font-utility);
    font-size: 11px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--v);
  }
  .recent-title {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 520;
    letter-spacing: -0.012em;
    color: var(--ink);
    line-height: 1.2;
  }
  .recent-dek {
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: var(--ink-mute);
    line-height: 1.5;
    display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; line-clamp: 2; overflow: hidden;
  }
  .recent-meta {
    display: inline-flex; gap: 0.5rem; align-items: center; margin-top: 0.15rem;
    font-family: var(--font-utility);
    font-size: 12px; font-weight: 500; color: var(--ink-mute);
  }

  .all-link { margin: 1.5rem 0 0; font-family: var(--font-body); font-size: 0.95rem; font-weight: 600; }
  .all-link a {
    color: var(--accent);
    text-decoration: none;
  }
  .all-link a:hover { text-decoration: underline; text-underline-offset: 3px; }

  /* ── Categories ────────────────────────────────────────────────────── */

  .cats-grid {
    list-style: none; margin: 0; padding: 0;
    display: flex; flex-wrap: wrap; gap: 0.65rem;
  }
  .cats-chip {
    --v: var(--v-personal);
    display: inline-flex; align-items: center; gap: 0.5rem;
    padding: 0.5rem 0.95rem;
    background: var(--paper-2);
    border: 1px solid var(--rule);
    border-radius: var(--radius-button);
    color: var(--ink); text-decoration: none;
    transition: border-color var(--dur-fast) var(--ease-out), background var(--dur-fast) var(--ease-out);
  }
  .cats-chip[data-vertical='dev'] { --v: var(--v-dev); }
  .cats-chip[data-vertical='finance'] { --v: var(--v-finance); }
  .cats-chip[data-vertical='culture'] { --v: var(--v-culture); }
  .cats-chip[data-vertical='health'] { --v: var(--v-health); }
  .cats-chip:hover { border-color: var(--v); background: color-mix(in oklab, var(--v) 8%, var(--paper-2)); }
  .cats-name { font-family: var(--font-body); font-size: 0.95rem; font-weight: 550; }
  .cats-count {
    font-family: var(--font-mono);
    font-size: 11px; color: var(--ink-mute);
    font-variant-numeric: tabular-nums;
  }
</style>
